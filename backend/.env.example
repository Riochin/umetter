# DB driver: "sqlite" (local) or "d1" (Cloudflare, Sprint 4)
DB_DRIVER=sqlite
DB_PATH=./umetter.db

# Cloudflare D1 credentials (only used when DB_DRIVER=d1)
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=

# JWT — set a strong random value in production
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRE_HOURS=720

PORT=8080

# Email verification
# EMAIL_DEBUG=true: do not actually send email, return debug_code in response
# EMAIL_DEBUG=false: send verification code via SMTP
EMAIL_DEBUG=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
