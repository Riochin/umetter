# DB driver: "sqlite" (local) or "d1" (Cloudflare, Sprint 4)
DB_DRIVER=sqlite
DB_PATH=./umetter.db

# Cloudflare D1 credentials (only used when DB_DRIVER=d1)
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=

# JWT — set a strong random value in production
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRE_HOURS=720

PORT=8080
